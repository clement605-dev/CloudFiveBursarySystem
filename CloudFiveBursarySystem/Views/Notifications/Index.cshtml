@model IEnumerable<CloudFiveBursarySystem.Models.Notification>

@{
    ViewData["Title"] = "My Notifications";

    var unreadCount = ViewBag.UnreadCount ?? 0;
}

<div class="container py-4">

    <!-- Page heading -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-bell-fill text-primary me-2"></i>
                My Notifications
            </h2>

            <p class="text-muted mb-0">
                Stay updated on your bursary applications and important announcements.
            </p>
        </div>

        @if (unreadCount > 0)
        {
            <form asp-controller="Notifications"
                  asp-action="MarkAllAsRead"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-outline-primary mt-3 mt-md-0">
                    <i class="bi bi-check2-all me-1"></i>
                    Mark All as Read
                </button>
            </form>
        }
    </div>

    <!-- Success message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Notification summary -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div>
                <h6 class="text-muted mb-1">Unread Notifications</h6>
                <h3 class="fw-bold mb-0">@unreadCount</h3>
            </div>

            <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                <i class="bi bi-bell text-primary fs-3"></i>
            </div>
        </div>
    </div>

    <!-- Notifications list -->
    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-3">

            @foreach (var notification in Model)
            {
                <div class="card border-0 shadow-sm
                                    @(notification.IsRead ? "" : "border-start border-primary border-4")">

                    <div class="card-body">

                        <div class="d-flex align-items-start">

                            <!-- Notification icon -->
                            <div class="rounded-circle p-3 me-3
                                        @(notification.IsRead ? "bg-light" : "bg-primary bg-opacity-10")">

                                @if (notification.NotificationType == "Application")
                                {
                                    <i class="bi bi-file-earmark-text fs-4 text-primary"></i>
                                }
                                else if (notification.NotificationType == "Payment")
                                {
                                    <i class="bi bi-cash-stack fs-4 text-success"></i>
                                }
                                else if (notification.NotificationType == "Programme")
                                {
                                    <i class="bi bi-mortarboard fs-4 text-info"></i>
                                }
                                else
                                {
                                    <i class="bi bi-bell fs-4 text-secondary"></i>
                                }
                            </div>

                            <!-- Notification content -->
                            <div class="flex-grow-1">

                                <div class="d-flex flex-wrap justify-content-between align-items-start">

                                    <div>
                                        <h5 class="fw-bold mb-1">
                                            @notification.Title

                                            @if (!notification.IsRead)
                                            {
                                                <span class="badge bg-primary ms-2">
                                                    New
                                                </span>
                                            }
                                        </h5>

                                        <span class="badge bg-light text-dark border">
                                            @notification.NotificationType
                                        </span>
                                    </div>

                                    <small class="text-muted mt-2 mt-md-0">
                                        <i class="bi bi-clock me-1"></i>
                                        @notification.DateCreated.ToString("dd MMM yyyy, HH:mm")
                                    </small>

                                </div>

                                <p class="text-muted mt-3 mb-3">
                                    @notification.Message
                                </p>

                                <!-- Notification actions -->
                                <div class="d-flex flex-wrap gap-2">

                                    @if (!string.IsNullOrWhiteSpace(notification.ActionUrl))
                                    {
                                        <a asp-controller="Notifications"
                                           asp-action="Open"
                                           asp-route-id="@notification.NotificationId"
                                           class="btn btn-sm btn-primary">

                                            View Details
                                            <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    }

                                    @if (!notification.IsRead)
                                    {
                                        <form asp-controller="Notifications"
                                              asp-action="MarkAsRead"
                                              asp-route-id="@notification.NotificationId"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary">

                                                <i class="bi bi-check2 me-1"></i>
                                                Mark as Read
                                            </button>
                                        </form>
                                    }

                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            }

        </div>
    }
    else
    {
        <!-- Empty state -->
        <div class="card border-0 shadow-sm text-center py-5">

            <div class="card-body">

                <i class="bi bi-bell-slash text-muted"
                   style="font-size: 4rem;"></i>

                <h4 class="fw-bold mt-3">
                    You're All Caught Up!
                </h4>

                <p class="text-muted mb-0">
                    You don't have any notifications at the moment.
                    We'll let you know when there are updates about your bursary.
                </p>

            </div>
        </div>
    }

</div>