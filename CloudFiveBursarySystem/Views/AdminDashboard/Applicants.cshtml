@model IEnumerable<CloudFiveBursarySystem.Models.Applicant>

@{
    ViewData["Title"] = "Registered Applicants";
}

<div class="container mt-4">

    <!-- Page heading -->
    <div class="mb-4">
        <h2 class="fw-bold">Registered Applicants</h2>
        <p class="text-muted">
            View and manage applicants registered on the CLOUD 5IVE system.
        </p>
    </div>

    <!-- Displays the total number of registered applicants -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h6 class="text-muted">Total Registered Applicants</h6>
            <h3 class="text-primary fw-bold">@Model.Count()</h3>
        </div>
    </div>

    <!-- Displays applicant records retrieved from SQL Server -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Applicant ID</th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>ID Number</th>
                                <th>Email Address</th>
                                <th>Phone Number</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var applicant in Model)
                            {
                                <tr>
                                    <td>@applicant.ApplicantId</td>
                                    <td>@applicant.FirstName</td>
                                    <td>@applicant.LastName</td>
                                    <td>@applicant.IDNumber</td>
                                    <td>@applicant.Email</td>
                                    <td>@applicant.PhoneNumber</td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Displays a message when no applicants exist -->
                <div class="alert alert-info">
                    No registered applicants were found.
                </div>
            }

        </div>
    </div>

    <!-- Returns the administrator to the dashboard -->
    <div class="mt-3">
        <a asp-controller="AdminDashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>