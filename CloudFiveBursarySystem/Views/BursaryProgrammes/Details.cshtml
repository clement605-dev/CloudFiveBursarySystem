@model CloudFiveBursarySystem.Models.BursaryProgramme

@{
    ViewData["Title"] = "Bursary Programme Details";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Bursary Programme Details</h2>
            <p class="text-muted">
                View the full information for this bursary opportunity.
            </p>
        </div>

        <span class="badge @(Model.ProgrammeStatus == "Open" ? "bg-success" : "bg-secondary") fs-6">
            @Model.ProgrammeStatus
        </span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h3 class="fw-bold mb-3">@Model.ProgrammeName</h3>

            <hr />

            <h6 class="text-muted fw-bold">PROGRAMME DESCRIPTION</h6>
            <p class="mb-4">@Model.Description</p>

            <h6 class="text-muted fw-bold">ELIGIBILITY CRITERIA</h6>
            <p class="mb-4">@Model.EligibilityCriteria</p>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <h6 class="text-muted fw-bold">FUNDING AMOUNT</h6>
                    <h4 class="text-primary fw-bold">
                        R @Model.FundingAmount.ToString("N2")
                    </h4>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-muted fw-bold">DATE CREATED</h6>
                    <p>@Model.DateCreated.ToString("dd MMMM yyyy")</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-muted fw-bold">APPLICATION OPENING DATE</h6>
                    <p>@Model.ApplicationOpeningDate.ToString("dd MMMM yyyy")</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-muted fw-bold">APPLICATION CLOSING DATE</h6>
                    <p>@Model.ApplicationClosingDate.ToString("dd MMMM yyyy")</p>
                </div>

            </div>

            <hr />

            <div class="d-flex gap-2 mt-3">

                <a asp-action="Edit"
                   asp-route-id="@Model.BursaryProgrammeId"
                   class="btn btn-primary">
                    Edit Programme
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Programmes
                </a>

            </div>

        </div>
    </div>

</div>