@model IEnumerable<CloudFiveBursarySystem.Models.ActivityLog>

@{
    ViewData["Title"] = "Activity Logs";

    var activities = Model?.ToList() ?? new List<CloudFiveBursarySystem.Models.ActivityLog>();

    var pendingSearch = ViewBag.SearchTerm as string ?? "";
    var selectedEntityType = ViewBag.EntityType as string ?? "";
    var entityTypes = ViewBag.EntityTypes as IEnumerable<string>
                     ?? Enumerable.Empty<string>();

    var selectedUserRole = ViewBag.UserRole as string ?? "";
    var userRoles = ViewBag.UserRoles as IEnumerable<string>
                    ?? Enumerable.Empty<string>();
}

<div class="container-fluid py-4">

    <!-- Page heading -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-clock-history text-primary me-2"></i>
                Activity Logs
            </h2>

            <p class="text-muted mb-0">
                Monitor and review activities performed by applicants and administrators across the system.
            </p>
        </div>

        <div class="badge bg-primary fs-6 px-3 py-2">
            @activities.Count Records
        </div>

    </div>

    <!-- Summary card -->
    <div class="row mb-4">

        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Total Activities</p>
                            <h3 class="fw-bold mb-0">@activities.Count</h3>
                        </div>
                        <i class="bi bi-journal-text fs-1 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Modules Recorded</p>
                            <h3 class="fw-bold mb-0">
                                @activities.Select(a => a.EntityType)
                                .Where(t => !string.IsNullOrWhiteSpace(t))
                                .Distinct()
                                .Count()
                            </h3>
                        </div>
                        <i class="bi bi-grid-1x2 fs-1 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Latest Activity</p>
                            <h6 class="fw-bold mb-0">
                                @(activities.OrderByDescending(a => a.DateCreated)
                                                                .FirstOrDefault()?.DateCreated.ToString("dd MMM yyyy")
                                                                ?? "No activity")
                            </h6>
                        </div>
                        <i class="bi bi-calendar-check fs-1 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Search and filter section -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <form asp-controller="AdminActivityLogs"
                  asp-action="Index"
                  method="get">

                <div class="row align-items-end">

                    <div class="col-md-5 mb-3">
                        <label class="form-label fw-semibold">
                            Search Activities
                        </label>

                        <input type="text"
                               name="searchTerm"
                               value="@pendingSearch"
                               class="form-control"
                               placeholder="Search user, action or description..." />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-semibold">
                            Filter by Module
                        </label>

                        <select name="entityType" class="form-select">
                            <option value="">All Modules</option>

                            @foreach (var type in entityTypes)
                            {
                                <option value="@type"
                                        selected="@(selectedEntityType == type)">
                                    @type
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label fw-semibold">
                            Filter by Role
                        </label>

                        <select name="userRole" class="form-select">
                            <option value="">All Users</option>

                            @foreach (var role in userRoles)
                            {
                                <option value="@role"
                                        selected="@(selectedUserRole == role)">
                                    @role
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 mb-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search me-1"></i>
                            Search
                        </button>
                    </div>

                </div>
            </form>

        </div>
    </div>

    <!-- Activity records -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ul me-2"></i>
                Recorded Activities
            </h5>
        </div>

        <div class="card-body">

            @if (activities.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>User</th>
                                <th>Role</th>
                                <th>Action</th>
                                <th>Description</th>
                                <th>Module</th>
                                <th>Date and Time</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var activity in activities)
                            {
                                <tr>

                                    <td>
                                        <div class="fw-semibold">
                                            <i class="bi bi-person-circle text-primary me-1"></i>
                                            @activity.UserEmail
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge @(activity.UserRole == "Administrator" ? "bg-primary" : activity.UserRole == "Applicant" ? "bg-success" : "bg-secondary")">
                                            @activity.UserRole
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @activity.Action
                                        </span>
                                    </td>

                                    <td>
                                        <span class="text-muted">
                                            @activity.Description
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @activity.EntityType
                                        </span>
                                    </td>

                                    <td>
                                        <div class="small fw-semibold">
                                            @activity.DateCreated.ToString("dd MMM yyyy")
                                        </div>

                                        <div class="small text-muted">
                                            @activity.DateCreated.ToString("HH:mm")
                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-clipboard-x display-3 text-muted"></i>

                    <h5 class="fw-bold mt-3">
                        No Activity Records Found
                    </h5>

                    <p class="text-muted mb-0">
                        There are currently no activities matching your search.
                    </p>

                </div>
            }

        </div>
    </div>

    <!-- Information note -->
    <div class="alert alert-info mt-4 border-0">

        <i class="bi bi-info-circle-fill me-2"></i>

        Activity logs help administrators monitor system usage and maintain
        accountability by recording important actions performed by applicants
        and administrators.

    </div>

</div>