@model IEnumerable<CloudFiveBursarySystem.Models.BursaryProgramme>

@{
    ViewData["Title"] = "Available Bursaries";

    // Selects a suitable photograph based on the bursary category.
    string GetProgrammeImage(string programmeName)
    {
        var name = programmeName.ToLower();

        if (name.Contains("stem"))
            return "https://images.unsplash.com/photo-1532094349884-543bc11b234d?w=900";

        if (name.Contains("information technology") ||
            name.Contains("software") || name.Contains("tech"))
            return "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=900";

        if (name.Contains("engineering"))
            return "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=900";

        if (name.Contains("teaching") || name.Contains("education"))
            return "https://images.unsplash.com/photo-1509062522246-3755977927d7?w=900";

        if (name.Contains("health") || name.Contains("medical"))
            return "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=900";

        return "https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=900";
    }
}

<style>
    .bursary-page {
        background: #f5f7fb;
        min-height: 75vh;
        padding: 35px 0 60px;
    }

    .bursary-heading {
        margin-bottom: 30px;
    }

        .bursary-heading h2 {
            color: #102b4e;
            font-weight: 750;
            font-size: 30px;
        }

        .bursary-heading p {
            color: #718096;
            font-size: 15px;
            max-width: 650px;
        }

    .bursary-count {
        background: #e8f0ff;
        color: #1456a0;
        padding: 9px 16px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 13px;
    }

    .bursary-card {
        background: #ffffff;
        border: none;
        border-radius: 13px;
        overflow: hidden;
        height: 100%;
        box-shadow: 0 4px 15px rgba(16, 43, 78, 0.07);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .bursary-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(16, 43, 78, 0.14);
        }

    .bursary-image {
        width: 100%;
        height: 205px;
        object-fit: cover;
        display: block;
    }

    .bursary-card .card-body {
        padding: 21px;
    }

    .bursary-title {
        color: #142d4e;
        font-size: 18px;
        font-weight: 700;
        min-height: 48px;
        margin-bottom: 10px;
    }

    .bursary-description {
        color: #718096;
        font-size: 13px;
        line-height: 1.6;
        min-height: 63px;
    }

    .bursary-funding {
        color: #102b4e;
        font-size: 21px;
        font-weight: 750;
        margin-bottom: 5px;
    }

    .funding-label {
        color: #8a96a8;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .closing-date {
        color: #58677b;
        font-size: 13px;
        margin-top: 12px;
    }

    .bursary-status {
        background: #e5f7ed;
        color: #16834b;
        font-size: 11px;
        font-weight: 700;
        padding: 6px 11px;
        border-radius: 20px;
    }

    .btn-bursary {
        background: #1266dc;
        color: white;
        border: none;
        border-radius: 7px;
        padding: 10px 16px;
        font-weight: 600;
        font-size: 13px;
        transition: background 0.2s ease;
    }

        .btn-bursary:hover {
            background: #0b4fae;
            color: white;
        }

    .empty-bursaries {
        background: white;
        border-radius: 13px;
        padding: 55px 20px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(16, 43, 78, 0.06);
    }

        .empty-bursaries h5 {
            color: #142d4e;
            font-weight: 700;
        }

    @@media (max-width: 576px) {
        .bursary-heading h2 {
            font-size: 24px;
        }

        .bursary-image {
            height: 190px;
        }
    }
</style>

<div class="bursary-page">

    <div class="container">

        <div class="bursary-heading">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>
                    <h2>Explore Bursary Opportunities</h2>

                    <p class="mb-0">
                        Discover funding opportunities, explore your options
                        and find financial support for your academic journey.
                    </p>
                </div>

                @if (Model.Any())
                {
                    <span class="bursary-count">
                        @Model.Count() Opportunities Available
                    </span>
                }

            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-bursaries">
                <h5>No bursary programmes available</h5>

                <p class="text-muted mb-0 mt-2">
                    There are currently no open bursary programmes accepting
                    applications. Please check again later.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var programme in Model)
                {
                    <div class="col-sm-6 col-lg-4">

                        <div class="card bursary-card">

                            <img src="@GetProgrammeImage(programme.ProgrammeName)"
                                 alt="@programme.ProgrammeName"
                                 class="bursary-image" />

                            <div class="card-body d-flex flex-column">

                                <h5 class="bursary-title">
                                    @programme.ProgrammeName
                                </h5>

                                <p class="bursary-description">
                                    @programme.Description
                                </p>

                                <hr class="my-2" />

                                <div class="mb-2">
                                    <div class="funding-label">
                                        Funding Amount
                                    </div>

                                    <div class="bursary-funding">
                                        R @programme.FundingAmount.ToString("N2")
                                    </div>
                                </div>

                                <div class="closing-date">
                                    <strong>Application closes:</strong>
                                    @programme.ApplicationClosingDate.ToString("dd MMM yyyy")
                                </div>

                                <div class="mt-3 mb-3">
                                    <span class="bursary-status">
                                        @programme.ProgrammeStatus
                                    </span>
                                </div>

                                <div class="mt-auto">
                                    <a asp-controller="AvailableBursaries"
                                       asp-action="Details"
                                       asp-route-id="@programme.BursaryProgrammeId"
                                       class="btn btn-bursary w-100">
                                        View Details
                                    </a>
                                </div>

                            </div>
                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>