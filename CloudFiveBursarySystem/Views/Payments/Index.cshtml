@model IEnumerable<CloudFiveBursarySystem.Models.Payment>

@{
    ViewData["Title"] = "Payment Records";

    // Calculate payment summary information.
    var totalPayments = Model.Count();
    var totalPaid = Model
        .Where(p => p.PaymentStatus == "Paid")
        .Sum(p => p.PaymentAmount);

    var pendingPayments = Model.Count(p => p.PaymentStatus == "Pending");

    var currency = new System.Globalization.CultureInfo("en-ZA");
}

<div class="container mt-4 mb-5">

    <!-- Page heading -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Payment Records</h2>

            <p class="text-muted mb-0">
                Record and manage bursary payments made to registered beneficiaries.
            </p>
        </div>

        <a asp-controller="Payments"
           asp-action="Create"
           class="btn btn-primary">
            + Record Payment
        </a>
    </div>

    <hr />

    <!-- Success message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Summary cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Payment Records</h6>

                    <h2 class="fw-bold text-primary">
                        @totalPayments
                    </h2>

                    <p class="mb-0">Recorded transactions</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Paid</h6>

                    <h2 class="fw-bold text-success">
                        @totalPaid.ToString("C2", currency)
                    </h2>

                    <p class="mb-0">Successfully recorded payments</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Pending Payments</h6>

                    <h2 class="fw-bold text-warning">
                        @pendingPayments
                    </h2>

                    <p class="mb-0">Awaiting payment</p>
                </div>
            </div>
        </div>

    </div>

    <!-- Payment records table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">Recorded Payments</h5>

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Payment Reference</th>
                                <th>Beneficiary</th>
                                <th>Amount</th>
                                <th>Payment Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var payment in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @payment.PaymentReference
                                    </td>

                                    <td>
                                        @(payment.Beneficiary?.BursaryApplication?.Applicant == null
                                                                        ? "Beneficiary unavailable"
                                                                        : $"{payment.Beneficiary.BursaryApplication.Applicant.FirstName} {payment.Beneficiary.BursaryApplication.Applicant.LastName}")
                            </td>

                                    <td class="fw-semibold">
                                        @payment.PaymentAmount.ToString("C2", currency)
                                    </td>

                                    <td>
                                        @payment.PaymentDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                @switch (payment.PaymentStatus)
                                        {
                                            case "Paid":
                                                <span class="badge bg-success">Paid</span>
                                                break;

                                            case "Pending":
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;

                                            case "Failed":
                                                <span class="badge bg-danger">Failed</span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">
                                                    @payment.PaymentStatus
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="Payments"
                                           asp-action="Details"
                                           asp-route-id="@payment.PaymentId"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>

                                        <a asp-controller="Payments"
                                           asp-action="Edit"
                                           asp-route-id="@payment.PaymentId"
                                           class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5 class="text-muted">
                        No Payment Records Yet
                    </h5>

                    <p class="text-muted">
                        Payment records will appear here once an administrator
                        records a payment for a beneficiary.
                    </p>

                    <a asp-controller="Payments"
                       asp-action="Create"
                       class="btn btn-primary">
                        Record First Payment
                    </a>

                </div>
            }

            <hr />

            <a asp-controller="AdminDashboard"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Dashboard
            </a>

        </div>
    </div>

</div>