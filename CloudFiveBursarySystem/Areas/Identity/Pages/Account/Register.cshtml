@page
@model RegisterModel

@{
    ViewData["Title"] = "Applicant Registration";
}

<style>
    /* Main registration page */
    .registration-page {
        min-height: calc(100vh - 70px);
        padding: 18px 15px 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        /* University-themed background image */
        background: linear-gradient( 90deg, rgba(5, 29, 59, 0.68), rgba(5, 29, 59, 0.12) ), url('/images/register-background.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    /* Registration card */
    .registration-card {
        width: 100%;
        max-width: 520px;
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        border: 2px solid rgba(255, 255, 255, 0.9);
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.25);
    }

    /* Navy blue registration heading */
    .registration-header {
        background: linear-gradient(135deg, #102c52, #07315e);
        color: white;
        text-align: center;
        padding: 15px 25px 14px;
    }

    .registration-logo {
        width: 50px;
        height: 50px;
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 7px;
        font-size: 25px;
        color: white;
    }

    .registration-header h2 {
        font-size: 21px;
        font-weight: 800;
        letter-spacing: 1px;
        margin-bottom: 2px;
    }

    .registration-subtitle {
        font-size: 9px;
        letter-spacing: 2px;
        margin-bottom: 10px;
        color: #dce8f8;
    }

    .registration-header h4 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .registration-description {
        font-size: 11px;
        margin-bottom: 0;
        color: #e8eff8;
    }

    /* Form content */
    .registration-body {
        padding: 17px 24px 15px;
        background: rgba(255, 255, 255, 0.98);
    }

    /* Form section headings */
    .form-section-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 8px;
        margin-bottom: 10px;
        border-bottom: 1px solid #e5eaf2;
        color: #102c52;
        font-size: 13px;
        font-weight: 700;
    }

    .form-section-icon {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #e7efff;
        color: #2460c7;
        font-size: 15px;
    }

    /* Input fields */
    .registration-form .form-label {
        font-size: 10px;
        font-weight: 700;
        color: #102c52;
        margin-bottom: 4px;
    }

    .registration-form .form-control {
        height: 29px;
        border: 1px solid #cbd8ea;
        border-radius: 7px;
        background-color: #fbfcff;
        font-size: 11px;
        padding: 6px 10px;
        color: #172b4d;
        box-shadow: none;
    }

        .registration-form .form-control:focus {
            border-color: #3675df;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(54, 117, 223, 0.12);
        }

    .registration-form textarea.form-control {
        height: 49px;
        resize: vertical;
    }

    .registration-form .mb-3 {
        margin-bottom: 9px !important;
    }

    .registration-form .text-danger {
        font-size: 10px;
    }

    /* Password input and visibility button */
    .password-wrapper {
        position: relative;
    }

        .password-wrapper .form-control {
            padding-right: 35px;
        }

    .password-toggle {
        position: absolute;
        right: 9px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #102c52;
        cursor: pointer;
        padding: 3px;
        font-size: 14px;
    }

    /* Create account button */
    .register-button {
        width: 100%;
        background: linear-gradient(135deg, #102c52, #07315e);
        border: none;
        border-radius: 8px;
        padding: 9px;
        color: white;
        font-size: 12px;
        font-weight: 700;
        margin-top: 3px;
        transition: 0.2s ease;
    }

        .register-button:hover {
            background: #194779;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(16, 44, 82, 0.2);
        }

    /* Login link */
    .login-link {
        text-align: center;
        margin-top: 11px;
        margin-bottom: 0;
        font-size: 11px;
        color: #52647d;
    }

        .login-link a {
            color: #0756c7;
            font-weight: 700;
            text-decoration: underline;
        }

    /* Validation summary */
    .validation-summary-errors {
        background: #fff0f0;
        border: 1px solid #f2caca;
        border-radius: 7px;
        padding: 8px 12px;
        margin-bottom: 12px;
        font-size: 11px;
    }

        .validation-summary-errors ul {
            margin-bottom: 0;
            padding-left: 18px;
        }

    /* Smaller screens */
    @@media (max-width: 576px) {
        .registration-page {
            padding: 15px 10px 25px;
            align-items: flex-start;
            background-position: center;
        }

        .registration-card {
            max-width: 100%;
        }

        .registration-body {
            padding: 17px 16px;
        }

        .registration-header {
            padding: 17px 15px;
        }
    }
</style>


<div class="registration-page">

    <div class="registration-card">

        <!-- CLOUD 5IVE registration heading -->
        <div class="registration-header">

            <div class="registration-logo">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <h2>CLOUD 5IVE</h2>

            <div class="registration-subtitle">
                BURSARY MANAGEMENT SYSTEM
            </div>

            <h4>Applicant Registration</h4>

            <p class="registration-description">
                Create your account and take the next step towards your educational goals.
            </p>

        </div>


        <!-- Registration form -->
        <div class="registration-body">

            <form id="registerForm"
                  class="registration-form"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">

                <!-- Registration validation messages -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger"
                     role="alert">
                </div>


                <!-- PERSONAL INFORMATION -->
                <div class="form-section-heading">

                    <span class="form-section-icon">
                        <i class="bi bi-person-vcard-fill"></i>
                    </span>

                    <span>Personal Information</span>

                </div>


                <!-- First name and surname -->
                <div class="row">

                    <div class="col-6 mb-3">

                        <label asp-for="Input.FirstName"
                               class="form-label">
                        </label>

                        <input asp-for="Input.FirstName"
                               class="form-control"
                               placeholder="Enter first name" />

                        <span asp-validation-for="Input.FirstName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-6 mb-3">

                        <label asp-for="Input.LastName"
                               class="form-label">
                        </label>

                        <input asp-for="Input.LastName"
                               class="form-control"
                               placeholder="Enter surname" />

                        <span asp-validation-for="Input.LastName"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- South African ID number -->
                <div class="mb-3">

                    <label asp-for="Input.IDNumber"
                           class="form-label">
                    </label>

                    <input asp-for="Input.IDNumber"
                           class="form-control"
                           placeholder="Enter South African ID number" />

                    <span asp-validation-for="Input.IDNumber"
                          class="text-danger">
                    </span>

                </div>


                <!-- Phone number -->
                <div class="mb-3">

                    <label asp-for="Input.PhoneNumber"
                           class="form-label">
                    </label>

                    <input asp-for="Input.PhoneNumber"
                           class="form-control"
                           placeholder="Enter phone number" />

                    <span asp-validation-for="Input.PhoneNumber"
                          class="text-danger">
                    </span>

                </div>


                <!-- Residential address -->
                <div class="mb-3">

                    <label asp-for="Input.Address"
                           class="form-label">
                    </label>

                    <textarea asp-for="Input.Address"
                              class="form-control"
                              rows="2"
                              placeholder="Enter your residential address"></textarea>

                    <span asp-validation-for="Input.Address"
                          class="text-danger">
                    </span>

                </div>


                <!-- ACCOUNT INFORMATION -->
                <div class="form-section-heading mt-3">

                    <span class="form-section-icon">
                        <i class="bi bi-lock-fill"></i>
                    </span>

                    <span>Account Information</span>

                </div>


                <!-- Email address -->
                <div class="mb-3">

                    <label asp-for="Input.Email"
                           class="form-label">
                    </label>

                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           placeholder="Enter email address" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>

                </div>


                <!-- Password and confirmation -->
                <div class="row">

                    <div class="col-6 mb-3">

                        <label asp-for="Input.Password"
                               class="form-label">
                        </label>

                        <div class="password-wrapper">

                            <input asp-for="Input.Password"
                                   id="passwordField"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Create a password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('passwordField', 'passwordEye')"
                                    aria-label="Show or hide password">

                                <i class="bi bi-eye-fill" id="passwordEye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-6 mb-3">

                        <label asp-for="Input.ConfirmPassword"
                               class="form-label">
                        </label>

                        <div class="password-wrapper">

                            <input asp-for="Input.ConfirmPassword"
                                   id="confirmPasswordField"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Confirm your password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('confirmPasswordField', 'confirmPasswordEye')"
                                    aria-label="Show or hide confirmation password">

                                <i class="bi bi-eye-fill" id="confirmPasswordEye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Create account -->
                <button id="registerSubmit"
                        type="submit"
                        class="btn register-button">

                    <i class="bi bi-person-fill-add me-2"></i>
                    Create Account

                </button>


                <!-- Existing account login link -->
                <p class="login-link">

                    Already have an account?

                    <a asp-page="./Login">
                        Sign in here
                    </a>

                </p>

            </form>

        </div>

    </div>

</div>


<!-- Password visibility functionality -->
<script>

    function togglePassword(fieldId, iconId) {

        const passwordField = document.getElementById(fieldId);
        const passwordEye = document.getElementById(iconId);

        if (passwordField.type === "password") {

            passwordField.type = "text";

            passwordEye.classList.remove("bi-eye-fill");
            passwordEye.classList.add("bi-eye-slash-fill");

        } else {

            passwordField.type = "password";

            passwordEye.classList.remove("bi-eye-slash-fill");
            passwordEye.classList.add("bi-eye-fill");

        }

    }

</script>


<!-- Client-side validation scripts -->
@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}